# Rust / Foundry build output
target/
contracts/out/
contracts/cache/
contracts/broadcast/

# Secrets — keys come from the environment, never files in the repo
.env
.env.*
!.env.example

# Regenerable graph output. Keep the semantic cache: it costs LLM tokens to rebuild.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/
!graphify-out/memory/
!graphify-out/reflections/

# Tool/editor state
.claude/*
!.claude/settings.json
!.claude/helpers/
.claude-flow/
.obsidian/
.DS_Store

# Bot runtime output
data/

# Arbitrum node provisioning state (instance/volume ids), written by provision-arbitrum-node.sh
infra/arbitrum-node/arbitrum-node-resources.env
*.proptest-regressions
.seqscope-ui-start.*

# Stray node-provisioning state and local scratch at the repo root
/arbitrum-*.json
/arbitrum-node-resources.env*
/arb-feed.tar.gz
__pycache__/
/.scan.sh
/.noticks.toml
