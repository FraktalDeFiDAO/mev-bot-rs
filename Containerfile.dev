# Development toolchain: Rust + Foundry. Used by scripts/dev.sh; the repo is bind-mounted.
FROM docker.io/library/archlinux@sha256:bf88f8143c3ef21b14d0ebb8140099f0bf75ecfc3699f357ff92317a73f5aba9

RUN pacman -Syu --noconfirm --needed ca-certificates cargo rust gcc git curl clang python \
    && pacman -Scc --noconfirm
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} dev && useradd -m -u ${APP_UID} -g ${APP_GID} dev
USER dev
ENV PATH=/home/dev/.foundry/bin:/home/dev/.cargo/bin:$PATH
RUN mkdir -p /home/dev/.foundry/bin \
    && curl --fail --silent --show-error --location \
       https://raw.githubusercontent.com/foundry-rs/foundry/50af4efe189dc64bad2b75ed6990b835de66c4ae/foundryup/foundryup \
       -o /home/dev/.foundry/bin/foundryup \
    && chmod 0755 /home/dev/.foundry/bin/foundryup \
    && /home/dev/.foundry/bin/foundryup --install v1.8.4
WORKDIR /workspace
