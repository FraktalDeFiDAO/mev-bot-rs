# Supply both Ethereum parent-chain URLs directly, or leave them blank and use
# the scoped SSM Parameter Store names below. On the host, keep this file 0600.
ETHEREUM_RPC_URL=
ETHEREUM_BEACON_URL=
NITRO_PARENT__CHAIN_CONNECTION_URL=
NITRO_PARENT__CHAIN_BLOB__CLIENT_BEACON__URL=

# Optional secure parameter names. The instance role can read only parameters
# under /mev-bot/arbitrum/ and decrypt them through SSM.
NITRO_SSM_PARENT_RPC_PARAMETER=/mev-bot/arbitrum/ethereum-rpc-url
NITRO_SSM_BEACON_RPC_PARAMETER=/mev-bot/arbitrum/ethereum-beacon-url

# Public Arbitrum One RPC used only as a sync-head comparison. It is not the
# Ethereum parent-chain RPC and is not required for Nitro operation.
ARBITRUM_REFERENCE_RPC_URL=https://arb1.arbitrum.io/rpc
