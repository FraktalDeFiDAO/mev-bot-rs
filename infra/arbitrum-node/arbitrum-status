#!/usr/bin/env bash
set -uo pipefail

RPC_URL="http://127.0.0.1:8547"
REFERENCE_RPC_URL="${ARBITRUM_REFERENCE_RPC_URL:-}"
if [[ -z "$REFERENCE_RPC_URL" && -r /etc/arbitrum/nitro.env ]]; then
  REFERENCE_RPC_URL="$(sed -n 's/^ARBITRUM_REFERENCE_RPC_URL=//p' /etc/arbitrum/nitro.env | head -n1)"
fi

if [[ "${1:-}" == "--help" ]]; then
  echo "Usage: arbitrum-status [--validate [timeout-seconds]]"
  exit 0
fi

rpc() {
  local endpoint="$1" method="$2" payload
  payload="$(jq -cn --arg method "$method" '{jsonrpc:"2.0",id:1,method:$method,params:[]}')"
  curl --fail --silent --show-error --max-time 8 \
    -H 'content-type: application/json' --data "$payload" "$endpoint"
}

hex_to_dec() {
  local value="${1#0x}"
  [[ -n "$value" ]] || value=0
  printf '%d' "$((16#$value))"
}

print_status() {
  echo "=== Host ==="
  uptime
  echo
  echo "=== Nitro service/container ==="
  systemctl --no-pager --full status arbitrum-nitro.service 2>&1 | head -n 12 || true
  docker ps --filter name=arbitrum-nitro --format 'container={{.Names}} status={{.Status}} image={{.Image}}' 2>/dev/null || true
  echo
  echo "=== Data volume ==="
  findmnt --target /data/arbitrum -o SOURCE,FSTYPE,OPTIONS 2>&1 || true
  df -hT /data/arbitrum 2>&1 || true
  du -sh /data/arbitrum/snapshot-download 2>/dev/null || true
  echo
  echo "=== CPU / memory / storage I/O ==="
  free -h 2>&1 || true
  (command -v iostat >/dev/null && iostat -dx 1 2) 2>&1 | tail -n 20 || true
  echo
  echo "=== RPC ==="

  local chain head syncing local_dec ref_result ref_dec behind
  if ! chain="$(rpc "$RPC_URL" eth_chainId 2>&1)"; then
    echo "HTTP RPC: unavailable (${chain})"
    echo "Expected chain ID: 0xa4b1 (42161)"
  else
    echo "eth_chainId: $(jq -r '.result // .error.message // "invalid response"' <<<"$chain")"
    if [[ "$(jq -r '.result // empty' <<<"$chain")" != "0xa4b1" ]]; then
      echo "CHAIN CHECK: FAILED (expected 0xa4b1 / 42161)"
    else
      echo "CHAIN CHECK: Arbitrum One (42161)"
    fi

    ws_status="$(curl --silent --show-error --max-time 3 --http1.1 -o /dev/null -w '%{http_code}' \
      -H 'Connection: Upgrade' -H 'Upgrade: websocket' \
      -H 'Sec-WebSocket-Version: 13' \
      -H "Sec-WebSocket-Key: $(head -c 16 /dev/urandom | base64)" \
      -H 'Origin: http://localhost' http://127.0.0.1:8548 2>/dev/null || true)"
    if [[ "$ws_status" == "101" ]]; then
      echo "WebSocket RPC: enabled (HTTP upgrade 101)"
    else
      echo "WebSocket RPC: unavailable (HTTP ${ws_status:-no response})"
    fi

    if head="$(rpc "$RPC_URL" eth_blockNumber 2>&1)"; then
      head="$(jq -r '.result // .error.message // "unknown"' <<<"$head")"
      if [[ "$head" =~ ^0x[0-9a-fA-F]+$ ]]; then
        local_dec="$(hex_to_dec "$head")"
        echo "local head: ${local_dec} (${head})"
      else
        local_dec=""
        echo "local head: ${head}"
      fi
    else
      local_dec=""
      echo "eth_blockNumber: ${head}"
    fi

    if syncing="$(rpc "$RPC_URL" eth_syncing 2>&1)"; then
      if [[ "$(jq -r '.result | type' <<<"$syncing")" == "boolean" ]]; then
        echo "eth_syncing: $(jq -r '.result' <<<"$syncing")"
      else
        echo "eth_syncing: $(jq -c '.result // .error' <<<"$syncing")"
      fi
    else
      echo "eth_syncing: unavailable (${syncing})"
    fi

    if [[ -n "$REFERENCE_RPC_URL" && -n "$local_dec" ]]; then
      if ref_result="$(rpc "$REFERENCE_RPC_URL" eth_blockNumber 2>&1)"; then
        ref_result="$(jq -r '.result // empty' <<<"$ref_result")"
        if [[ "$ref_result" =~ ^0x[0-9a-fA-F]+$ ]]; then
          ref_dec="$(hex_to_dec "$ref_result")"
          behind=$((ref_dec - local_dec))
          (( behind < 0 )) && behind=0
          echo "reference head: ${ref_dec} (${ref_result})"
          echo "blocks behind reference: ${behind}"
        else
          echo "reference RPC returned an invalid block height"
        fi
      else
        echo "reference RPC: unavailable (${ref_result})"
      fi
    else
      echo "reference comparison: not configured"
    fi
  fi

  echo
  echo "=== Recent feed / sync / error log lines ==="
  docker logs --since 10m arbitrum-nitro 2>&1 | \
    grep -Ei 'feed|sequencer|sync|snapshot|error|warn|fatal' | tail -n 25 || true
}

if [[ "${1:-}" != "--validate" ]]; then
  print_status
  exit 0
fi

timeout_seconds="${2:-600}"
if ! [[ "$timeout_seconds" =~ ^[0-9]+$ ]]; then
  echo "timeout-seconds must be a positive integer" >&2
  exit 2
fi
deadline=$((SECONDS + timeout_seconds))
last_head=""
progress_seen=false
last_ws_status=""
while (( SECONDS <= deadline )); do
  chain_result="$(rpc "$RPC_URL" eth_chainId 2>/dev/null || true)"
  if [[ "$(jq -r '.result // empty' <<<"$chain_result" 2>/dev/null)" == "0xa4b1" ]]; then
    head_result="$(rpc "$RPC_URL" eth_blockNumber 2>/dev/null || true)"
    current_head="$(jq -r '.result // empty' <<<"$head_result" 2>/dev/null)"
    syncing_result="$(rpc "$RPC_URL" eth_syncing 2>/dev/null || true)"
    syncing_value="$(jq -r '.result // empty' <<<"$syncing_result" 2>/dev/null)"
    ws_status="$(curl --silent --show-error --max-time 3 --http1.1 -o /dev/null -w '%{http_code}' \
      -H 'Connection: Upgrade' -H 'Upgrade: websocket' \
      -H 'Sec-WebSocket-Version: 13' \
      -H "Sec-WebSocket-Key: $(head -c 16 /dev/urandom | base64)" \
      -H 'Origin: http://localhost' http://127.0.0.1:8548 2>/dev/null || true)"
    last_ws_status="$ws_status"
    if [[ "$current_head" =~ ^0x[0-9a-fA-F]+$ ]]; then
      echo "chain=42161 local_head=$(hex_to_dec "$current_head") syncing=${syncing_value:-unknown} websocket_http=${ws_status:-unavailable}"
      [[ -n "$last_head" && "$current_head" != "$last_head" ]] && progress_seen=true
      last_head="$current_head"
      if [[ "$syncing_value" != "false" && -n "$syncing_value" ]]; then
        progress_seen=true
      fi
      if [[ -n "$REFERENCE_RPC_URL" ]]; then
        ref_result="$(rpc "$REFERENCE_RPC_URL" eth_blockNumber 2>/dev/null || true)"
        ref_head="$(jq -r '.result // empty' <<<"$ref_result" 2>/dev/null)"
        if [[ "$ref_head" =~ ^0x[0-9a-fA-F]+$ ]]; then
          lag=$(( $(hex_to_dec "$ref_head") - $(hex_to_dec "$current_head") ))
          (( lag < 0 )) && lag=0
          echo "reference_head=$(hex_to_dec "$ref_head") blocks_behind=${lag}"
          if [[ "$syncing_value" == "false" && $lag -le 100 && "$ws_status" == "101" ]]; then
            echo "VALIDATION: HTTP and WebSocket RPC respond on chain 42161; node is within 100 blocks of reference head."
            exit 0
          fi
        fi
      fi
    fi
  else
    echo "Waiting for Arbitrum One HTTP RPC..."
  fi
  sleep 30
done

if [[ "$progress_seen" == true && "$last_ws_status" == "101" ]]; then
  echo "VALIDATION: HTTP and WebSocket RPC respond on chain 42161 and Nitro reports active sync or a changing head."
  exit 0
fi
echo "VALIDATION: no trusted sync completion or head progress was confirmed within ${timeout_seconds}s." >&2
exit 1
