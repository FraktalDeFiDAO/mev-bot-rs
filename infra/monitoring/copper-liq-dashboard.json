{
  "title": "Copper liquidation: scheduler and Jev advisor",
  "uid": "copper-liq-jev",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "copper",
    "liquidation",
    "jev"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Hot-path SLOs (shadow scheduler)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mandatory deadline misses (per 5m)",
      "description": "Overdue P0/P1 jobs seen by shadow passes. Must stay at 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tier, reason) (increase(copper_liq_recheck_deadline_miss_total[5m]))",
          "legendFormat": "{{tier}} {{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recheck queue depth by tier",
      "description": "Candidate jobs per tier in the last pass.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_liq_recheck_queue_depth",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Seconds since last scheduler pass",
      "description": "Alert CopperLiqSchedulerPassStale fires above 180.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - copper_liq_sched_last_pass_timestamp_seconds"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Scheduler passes (1h)",
      "description": "Shadow passes observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_liq_sched_passes_total[1h])"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Advisory passes (1h)",
      "description": "Advisory shadow passes observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_liq_advisory_passes_total[1h])"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Mandatory coverage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Coverage violations (per 10m)",
      "description": "Sweep capacity or overdue mandatory backlog. Must stay at 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_liq_coverage_violation_total[10m])",
          "legendFormat": "violations"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Advisory changed P0/P1 output (per 15m)",
      "description": "Invariant breach counter. Must stay at 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_liq_advisory_mandatory_changed_total[15m])",
          "legendFormat": "mandatory changed"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Jev quality and cost (advisory only)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Jev attempts by result (rate)",
      "description": "HTTP attempts per second by result.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(copper_jev_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Jev request latency p95",
      "description": "From copper_jev_request_duration_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(copper_jev_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Circuit state (0 closed, 1 half-open, 2 open)",
      "description": "Advisory-only: open means baseline in use.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_circuit_state",
          "legendFormat": "state"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_circuit_misconfigured",
          "legendFormat": "misconfigured"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Fallbacks by reason (per 15m)",
      "description": "Calls that returned no advisory; policy and client reasons share the metric name, separated by job.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (increase(copper_jev_fallback_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tokens (per hour)",
      "description": "Billed tokens.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_input_tokens_total[1h])",
          "legendFormat": "input"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_output_tokens_total[1h])",
          "legendFormat": "output"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Estimated cost USD (per hour)",
      "description": "Zero unless JEV_PRICE_* are configured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_estimated_cost_usd_total[1h])",
          "legendFormat": "usd"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Budget window usage",
      "description": "Current hourly window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_window_requests_used",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_window_tokens_used",
          "legendFormat": "tokens"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_window_cost_usd_used",
          "legendFormat": "usd"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Stale or expired answers (per 30m)",
      "description": "Decisions discarded as stale or expired.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_stale_response_total[30m])",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Advisor outbox rows",
      "description": "Rows by state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "copper_jev_advisor_queue_rows",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Advisor worker events (per 15m)",
      "description": "claimed, applied, superseded, dead_*, lease_lost, ...",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event) (increase(copper_jev_advisor_events_total[15m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Would-be bonuses by tier (per hour)",
      "description": "Shadow policy only; nothing is dispatched differently.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tier) (increase(copper_jev_applied_bonus_total[1h]))",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Cache hits and coalesced (per hour)",
      "description": "Requests saved by the client.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_cache_hits_total[1h])",
          "legendFormat": "cache hits"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(copper_jev_coalesced_total[1h])",
          "legendFormat": "coalesced"
        }
      ]
    },
    {
      "id": 23,
      "type": "row",
      "title": "Replay outcomes (offline artifacts, not live series)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 71
      },
      "panels": []
    },
    {
      "id": 24,
      "type": "text",
      "title": "Baseline vs advisory replay reports",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "options": {
        "mode": "markdown",
        "content": "Replay results are produced offline by `mev-liq-replay` (JEV-LIQ-006) and are not scraped. Read the reports in `docs/audits/evidence/jev-liq-006/` (`quiet.json`, `oracle-shock.json`, `overload.json`) and the advisory comparison described in `docs/design/jev-liq-011-advisory-policy.md`. `copper_liq_policy_actionable_recall` is evaluation-only and is produced by task JEV-LIQ-017, not exported here. Reports contain recorded borrower addresses; review before sharing."
      }
    }
  ]
}
