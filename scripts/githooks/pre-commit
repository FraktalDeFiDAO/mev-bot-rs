#!/usr/bin/env bash
# Block secrets and unformatted code before they reach history.
set -euo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-commit: refusing to commit a .env file" >&2; exit 1
fi
# 64-hex private keys and common RPC key URLs
if git diff --cached -U0 -- . ':(exclude)Cargo.lock' ':(exclude)**/*.lock' | grep -E '^\+' | grep -v 'checksum' | grep -v 'sha256:' | grep -Ei '(0x)?[0-9a-f]{64}\b|(alchemy\.com/v2/|infura\.io/v3/|quiknode\.pro/)[A-Za-z0-9_-]{16,}' \
   | grep -Ev '(tx|hash|topic|codehash|keccak|selector)' >/dev/null; then
  echo "pre-commit: possible private key or RPC API key in staged changes — remove it or use env vars" >&2
  echo "  (bypass only for known-safe fixtures: git commit --no-verify)" >&2
  exit 1
fi
if command -v gitleaks >/dev/null; then gitleaks git --staged --no-banner --redact; fi
if [ -f Cargo.toml ] && echo "$staged" | grep -q '\.rs$'; then cargo fmt --all --check; fi
if [ -f contracts/foundry.toml ] && echo "$staged" | grep -q '^contracts/.*\.sol$'; then (cd contracts && forge fmt --check); fi
